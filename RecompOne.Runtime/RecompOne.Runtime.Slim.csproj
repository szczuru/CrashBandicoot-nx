<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RecompOne.Runtime</RootNamespace>
    <AssemblyName>RecompOne.Runtime</AssemblyName>
    <DefineConstants>$(DefineConstants);SWITCH_SLIM</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wszystko z drzewa Runtime -->
    <Compile Include="**/*.cs" />

    <!-- ===== DESKTOP / UI / PLATFORM-SPECIFIC — WYCIĘTE DLA SWITCH SLIM ===== -->

    <!-- Host window / panele / ImGui -->
    <Compile Remove="Host/Window/**/*.cs" />

    <!-- Desktop audio / input (Silk, OpenAL) -->
    <Compile Remove="Host/Audio.cs" />
    <Compile Remove="Host/InputManager.cs" />
    <Compile Remove="Host/**/Silk*.cs" />
    <Compile Remove="Host/**/*OpenAL*.cs" />
    <Compile Remove="Host/**/*Glfw*.cs" />
    <Compile Remove="Host/**/*ImGui*.cs" />

    <!-- Catalog / CD zależne od Modding (niepotrzebne na Switch slim) -->
    <Compile Remove="Catalog/TextureReplacements.cs" />
    <Compile Remove="Catalog/TexturesCatalog.cs" />
    <Compile Remove="Cdrom/DiscOverlay.cs" />

    <!-- Config zależny od ImGui / Silk / paneli -->
    <Compile Remove="Config/ConfigManager.cs" />
    <Compile Remove="Config/KeyBindingNames.cs" />

    <!-- OpenGL HLE backend (Silk) — Switch używa soft VRAM + SDL present -->
    <Compile Remove="Gpu/Hle/Gl/**/*.cs" />

    <!-- Catalog PNG (StbImage) — niepotrzebne na konsoli do gry -->
    <Compile Remove="Catalog/PngBgr555.cs" />

    <!-- Modding (MonoMod, Roslyn) -->
    <Compile Remove="Modding/**/*.cs" />

    <!-- Ewentualne inne desktopowe ścieżki -->
    <Compile Remove="**/Desktop/**/*.cs" />
  </ItemGroup>

  <!-- Celowo BRAK PackageReference do Silk, ImGui, StbImage, MonoMod, Roslyn.
       Jeśli coś jeszcze ich wymaga — dopisz kolejny Compile Remove, nie pakiet. -->
</Project>
