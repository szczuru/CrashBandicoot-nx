<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RecompOne.Runtime</RootNamespace>
    <AssemblyName>RecompOne.Runtime</AssemblyName>
    <DefineConstants>$(DefineConstants);SWITCH_SLIM</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- zostaw true (domyślnie): SDK sam bierze .raw / .json -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" />

    <Compile Remove="Host/Window/**/*.cs" />
    <Compile Remove="Host/Audio.cs" />
    <Compile Remove="Host/InputManager.cs" />
    <Compile Remove="Host/**/Silk*.cs" />
    <Compile Remove="Host/**/*OpenAL*.cs" />
    <Compile Remove="Host/**/*Glfw*.cs" />
    <Compile Remove="Host/**/*ImGui*.cs" />
    <Compile Remove="Host/Cheats/**/*.cs" />
    <Compile Remove="Host/Diagnostics/**/*.cs" />

    <Compile Remove="Config/ConfigManager.cs" />
    <Compile Remove="Config/KeyBindingNames.cs" />

    <Compile Remove="Gpu/Hle/Gl/**/*.cs" />

    <Compile Remove="Catalog/PngBgr555.cs" />
    <Compile Remove="Catalog/TextureReplacements.cs" />
    <Compile Remove="Catalog/TexturesCatalog.cs" />
    <Compile Remove="Cdrom/DiscOverlay.cs" />

    <Compile Remove="Modding/**/*.cs" />
    <Compile Remove="**/Desktop/**/*.cs" />

    <Compile Remove="Runtime.cs" />
  </ItemGroup>

  <!-- BRAK ItemGroup EmbeddedResource — SDK doda Bios/Fonts/*.raw i Catalog/data/*.json sam -->
</Project>
